APP_NAME="HUDEC Inventory BI"
APP_VERSION=1.0.0
BRAND_NAME=hudec
CLASSIFICATION_LABEL="Clasificación HUDEC"
TIMEZONE=America/Lima

# =============================================================================
# CREDENCIALES DE BASE DE DATOS POSTGRESQL
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=database_kawii_pluss
