# =============================================================================
# PARÁMETROS OPERATIVOS Y DE ANALÍTICA DE INVENTARIO
# =============================================================================
# IDs de las sucursales de tiendas físicas (venta al público) separadas por comas.
# Ejemplo: 1,3
OFFICES_TIENDA=1,3

# ID del Almacén Central (solo recepciones, no genera ventas).
# Ejemplo: 4
OFFICE_ALMACEN=4

# IDs de los tipos de documentos de venta oficiales en BSale, separados por comas.
# Ejemplo: 1,10,50,51,52,53
TIPOS_VENTA=1,10,50,51,52,53

# IDs de los tipos de documentos de devolución (notas de crédito), separados por comas.
# Ejemplo: 9,40,43
TIPOS_DEVOLUCION=9,40,43

# =============================================================================
# PARÁMETROS DE EXCLUSIÓN TAXONÓMICA
# =============================================================================
# IDs de los departamentos a excluir de los análisis de inventario, separados por comas.
# Ejemplo: 11,12
EXCLUDED_DEPARTMENTS=11,12

# IDs de las categorías a excluir de los análisis de inventario, separadas por comas.
# Ejemplo: 73,74,75,76
EXCLUDED_CATEGORIES=73,74,75,76
