# =============================================================================
# PLANTILLA DE CONFIGURACIÓN POR EMPRESA  (copiar a .env y completar)
# =============================================================================
# Cada empresa = una copia del sistema con su propio .env + su propia base de datos.
# Llena los valores PROPIOS DE LA EMPRESA y arranca. Ver docs/REPLICAR_EMPRESA.md.
# Marca con (*) lo que cambia en cada empresa.

# --- Identidad / marca (white-label) ----------------------------------------
APP_NAME="kawii api"
APP_VERSION=1.0.0
BRAND_NAME=mi_empresa                 # (*) nombre interno de la empresa
CLASSIFICATION_LABEL="Clasificación"  # (*) etiqueta de la columna de clasificación
TIMEZONE=America/Lima                 # zona del negocio (Perú = America/Lima)

# --- Base de datos PostgreSQL ------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_empresa_x                  # (*) UNA base por empresa (créala antes)
DB_USER=postgres
DB_PASSWORD=CAMBIAR                    # (*) secreto — no commitear el .env real

# --- BSale (cada empresa tiene su cuenta) ------------------------------------
BSALE_TOKEN=CAMBIAR                    # (*) token de la cuenta BSale de la empresa

# --- Parámetros operativos (IDs de BSale: estables por empresa) --------------
# Estos IDs vienen de la cuenta BSale de la empresa y NO cambian con los re-seeds.
OFFICES_TIENDA=1,3                     # (*) IDs de sucursales que venden
OFFICE_ALMACEN=4                       # (*) ID del almacén (solo recibe)
TIPOS_VENTA=1,10,50,51,52,53           # (*) tipos de documento de venta en su BSale
TIPOS_DEVOLUCION=9,40,43               # (*) tipos de nota de crédito
TIPOS_TRASLADO=53                      # (*) tipo de traslado interno (Coya=53, otros=37)

# --- Restricciones POR NOMBRE (separadas por "|", NO coma) -------------------
# Se referencian por NOMBRE de departamento porque los IDs de la taxonomía local
# se reasignan en cada re-seed del sync. El sistema resuelve el ID actual al consultar.
# EXCLUDED_* siembra la DB (app_config) en el primer arranque; luego se ajusta en vivo
# desde la pantalla "Configuración" del frontend.
EXCLUDED_DEPARTMENTS=                  # (*) ej: Temporada y Celebraciones|Librería y Oficina
EXCLUDED_CATEGORIES=
SEASONAL_DEPARTMENTS=                  # (*) ej: Temporada y Celebraciones  (campaña)

# --- Otros -------------------------------------------------------------------
TARGET_CATEGORIES=228,221,145          # categorías objetivo del reporte de salud

# --- IDs de BSale específicos por empresa (CRÍTICO) --------------------------
# (*) IDs de USUARIOS BSale que son almaceneros. Solo sus recepciones cuentan
#     como llegadas reales; el resto son ajustes contables (cajeros/admins).
#     Sacar de BSale → Usuarios y poner los IDs de almacén.
BSALE_WAREHOUSE_USER_IDS=                # (*) ej: 2,4,5,14,16

# Tope de sanidad para qty en recepciones (filtra códigos de barras tipeados).
# Ajustar al máximo legítimo razonable del negocio (+ holgura).
RECEPTION_QTY_SANITY_LIMIT=50000

# --- Ventanas de análisis (DÍAS) — política comercial ------------------------
# Cambiarlas afecta la lógica de TODAS las matrices. Los nombres de columnas
# ("Unds Vend (90d)", "Vel últimos 30d") están fijos en SQL y no se renombran.
# Recomendado: dejar defaults salvo causa fuerte.
WINDOW_MAIN_DAYS=90                    # ventana operativa principal
WINDOW_TREND_SPLIT_DAYS=45             # split tendencia (suele ser MAIN/2)
WINDOW_RECENT_DAYS=30                  # velocidad reciente
WINDOW_BLIND_SPOT_DAYS=180             # filtro fantasmas / oportunidades perdidas
WINDOW_NEW_PRODUCT_DAYS=15             # gracia para "NUEVO" en informe consolidado
WINDOW_DEAD_DAYS=60                    # "muerto" sin venta en N días (informe 07)
PISO_DIAS_LOTE=7                       # piso anti-distorsión velocidad
COBERTURA_OBJETIVO_DIAS=45             # cobertura ideal y techo del rango "sano"

# --- Umbrales de clasificación (política comercial) -------------------------
# Cada empresa puede ajustarlos. Si los dejás vacíos se usan los defaults del código.
SELLTHROUGH_EXITO_RATIO=0.80           # ≥ 80% del lote salió = vendió todo
LOSS_CONSUMO_RATIO=0.50                # consumos > 50% recibido (junto con LOSS_VENTA) = pérdida total
LOSS_VENTA_RATIO=0.20                  # ventas < 20% recibido (junto con LOSS_CONSUMO) = pérdida total
TREND_GROW_MULT=1.5                    # v_recent > v_old × 1.5 → Creciendo
TREND_DECAY_MULT=0.7                   # v_recent < v_old × 0.7 → Decayendo
XYZ_CONSTANTE_PCT=20                   # frecuencia ≥ 20% → demanda constante
XYZ_VARIABLE_PCT=8                     # frecuencia ≥ 8% → demanda variable

PROY_MES_ALTA=30                       # ≥ 30 unds/mes → alta rotación
PROY_MES_MIN_FLOOR=3                   # piso del umbral adaptativo "vendedor lento"
PROY_MES_MIN_CAP=10                    # techo del mismo
PROY_MES_CAT_RATIO=0.5                 # ratio sobre velocidad promedio de la categoría

COBERTURA_CRITICA_DIAS=15              # ≤ 15d = reposición urgente
COBERTURA_BAJA_DIAS=30                 # < 30d = stock justo

DIAS_ABSORCION_BESTSELLER_MAX=45       # ≤ 45d para agotar lote = bestseller real
DSV_QUIEBRE_MAX_DIAS=14                # ≤ 14d desde última venta + sin stock = quiebre caliente
LIFETIME_BESTSELLER_MIN=50             # ≥ 50 unds vida = histórico

LOTE_FRENADO_STOCK_MIN=5
LOTE_FRENADO_PROY_MIN=10
LOTE_FRENADO_PROY30_MAX=5
LOTE_FRENADO_EDAD_MIN=90

LENTO_CRONICO_DSV_MIN=8
LENTO_CRONICO_LIFETIME_MAX=60
LENTO_CRONICO_PROY_MAX=5

RECIEN_REABASTECIDO_DIAS=14            # ≤ 14d desde recep = no juzgar todavía
TRANSFER_DONOR_STOCK_MIN=5             # stock mín del donante para sugerir transferencia
